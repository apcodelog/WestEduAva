<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Client"
             x:Class="Client.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator></local:ViewLocator>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="Assets/Styles/NavButtonStyles.axaml" />
        <StyleInclude Source="Assets/Styles/ListStyles.axaml" />
        <StyleInclude Source="Assets/Styles/HeadingStyles.axaml" />
        <StyleInclude Source="Assets/Styles/LabelStyles.axaml" />
        <StyleInclude Source="Assets/Styles/InputStyles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>            
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Assets/Resources/ColorResources.axaml" />
                <ResourceInclude Source="/Assets/Resources/AppResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>