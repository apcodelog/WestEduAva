<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Client.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="Assets/Styles/NavButtonStyles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <SolidColorBrush x:Key="ColorBg1" Color="#d4d4d8" />
        <SolidColorBrush x:Key="ColorBg2" Color="#52525b" />
        <SolidColorBrush x:Key="ColorText1" Color="#18181b" />
    </Application.Resources>

</Application>