<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20">
      <StackPanel Width="400" Spacing="20">
        <Label Content="Label Default" />
        <Label Classes="form" Content="Label Default" />
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <Style Selector="Label" >
    <Setter Property="Foreground" Value="{DynamicResource ColorText1}" />
  </Style>

  <Style Selector="Grid.form Label">
    <Setter Property="HorizontalContentAlignment" Value="Right" />
    <Setter Property="VerticalContentAlignment" Value="Bottom" />
    <Setter Property="Height" Value="{DynamicResource FormRowH}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
  </Style>
</Styles>
