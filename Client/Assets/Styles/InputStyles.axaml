<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20">
      <Grid Classes="form" RowSpacing="5" ColumnSpacing="5" ColumnDefinitions="180, 150" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto">
        <Label Grid.Column="0" Grid.Row="0" Content="Kurskod" />
        <TextBox Grid.Column="1" Grid.Row="0" />
        
        <Label Grid.Column="0" Grid.Row="1" Content="Titel" />
        <TextBox Grid.Column="1" Grid.Row="1" Text="Abc" />

        <Label Grid.Column="0" Grid.Row="2" Content="Kurstyp" />
        <ComboBox Grid.Column="1" Grid.Row="2" />

        <Label Grid.Column="0" Grid.Row="3" Content="Antal utbildningsdagar" />
        <NumericUpDown Grid.Column="1" Grid.Row="3" Minimum="1" Value="1" />

        <Label Grid.Column="0" Grid.Row="4" Content="Startdatum" />
        <CalendarDatePicker Grid.Column="1" Grid.Row="4" />
        
        <Label Grid.Column="0" Grid.Row="5" Content="Slutdatum" />
        <CalendarDatePicker Grid.Column="1" Grid.Row="5" />
      </Grid>
    </Border>
  </Design.PreviewWith>


</Styles>
