<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  
  <FontFamily x:Key="IconFont">avares://Client/Assets/Fonts/Phosphor.ttf#Phosphor</FontFamily>
    
  <SolidColorBrush x:Key="ColorBg1" Color="{DynamicResource _colorBg1}" />
  <SolidColorBrush x:Key="ColorBg2" Color="{DynamicResource _colorBg2}" />
  <SolidColorBrush x:Key="ColorBg2V" Color="{DynamicResource _colorBg2V}" />
  <SolidColorBrush x:Key="ColorText1" Color="{DynamicResource _colorText1}" />

</ResourceDictionary>
