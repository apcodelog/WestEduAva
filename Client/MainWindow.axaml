<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Client.MainWindow"
        Title="Client">
    
    <StackPanel Background="#d4d4d8">
        <Border Background="#52525b" BorderBrush="#18181b" BorderThickness="0 0 0 1">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10" Height="60">
                <Button Classes="nav" Content="H" />
                <Button Classes="nav" Content="C" />
                <Button Classes="nav" Content="S" />
                <Button Classes="nav" Content="T" />
            </StackPanel>
        </Border>

        <TextBlock Text="Here is some test text" FontSize="40" Foreground="#18181b" />

    </StackPanel>

</Window>
