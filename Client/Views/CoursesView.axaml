<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:li="using:LoadingIndicators.Avalonia"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.CoursesView"
             x:DataType="vm:CoursesViewModel">
  
  <Design.DataContext>
    <vm:CoursesViewModel></vm:CoursesViewModel>
  </Design.DataContext>

  <StackPanel Margin="60 20">
    <TextBlock Classes="h1" Text="{Binding PageTitle}" />

    <StackPanel>
      <Grid Classes="list" ColumnDefinitions="20, 80, 340, *" Background="{DynamicResource ColorBg2}">
          <Label Grid.Column="1" Content="Kurskod" />
          <Label Grid.Column="2" Content="Titel" />
          <Button Grid.Column="3" FontFamily="Default" HorizontalAlignment="Left" 
           Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToCourseNewCommand}" Content="+ Lägg till kurs" />
      </Grid>

      <ScrollViewer Height="350">

        <ItemsControl ItemsSource="{Binding Courses}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Classes="list">
                  <Grid ColumnDefinitions="20, 80, 400, 20, 20" RowDefinitions="Auto, Auto">
                      <Button Grid.Column="0" Command="{Binding ToggleExpandedCommand}" Content="&#xe2ce;" />
                      <Label Grid.Column="1" Content="{Binding CourseNumber}" />
                      <Label Grid.Column="2" Content="{Binding Title}" />
                      <Button Grid.Column="3" Content="&#xe3b4;" 
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToCourseEditCommand}"
                        CommandParameter="{Binding Id}" />
                      <Button Grid.Column="4" Content="&#xe4a8;" 
                        Command="{Binding $parent[UserControl].DataContext.ShowPopupCommand}"
                        CommandParameter="{Binding Id}" />
                      <TextBlock Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3" IsVisible="{Binding IsExpanded}" Text="{Binding DetailsLines}" />
                  </Grid>
                  <Border />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </ScrollViewer>

    </StackPanel>


    <Popup IsOpen="{Binding PopupVisible}" Placement="Center">
      <Border Background="{DynamicResource ColorBg1}" BorderBrush="{DynamicResource ColorText1}" BorderThickness="1" Padding="40 30">
        <StackPanel Spacing="20">
          <TextBlock HorizontalAlignment="Center" Classes="h2" Text="Bekräfta borttagning" />
          <StackPanel Height="60" IsVisible="{Binding !IsBusy}" Spacing="10" HorizontalAlignment="Center" Orientation="Horizontal">
            <Button Classes="nav" Command="{Binding DeleteCommand}">
                <StackPanel>
                    <Label Content="&#xe4a8;" />
                    <Label Content="Ta bort" />
                </StackPanel>
            </Button>
            <Button Classes="nav" Command="{Binding HidePopupCommand}">
                <StackPanel>
                    <Label Content="&#xe4f6;" />
                    <Label Content="Avbryt" />
                </StackPanel>
            </Button>
          </StackPanel>
          <li:LoadingIndicator Height="20" Padding="0 10" IsVisible="{Binding IsBusy}" Mode="ThreeDots" SpeedRatio=".8" />
        </StackPanel>
      </Border>
    </Popup>
  </StackPanel>

</UserControl>
