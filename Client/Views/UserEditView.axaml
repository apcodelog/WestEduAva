<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.UserEditView"
             x:DataType="vm:UserEditViewModel">
  
  <Design.DataContext>
    <vm:UserEditViewModel></vm:UserEditViewModel>
  </Design.DataContext>

  <StackPanel Width="500" HorizontalAlignment="Left" Margin="60 40" Spacing="15">
      <TextBlock Classes="h2" Text="{Binding PageTitle}" />
      <UniformGrid Columns="3" ColumnSpacing="20">
        <StackPanel>
          <Label Grid.Column="0" Grid.Row="0" Content="Förnamn" />
          <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding FirstName}" />
        </StackPanel>
        <StackPanel>
          <Label Grid.Column="0" Grid.Row="0" Content="Efternamn" />
          <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding LastName}" />
        </StackPanel>
        <StackPanel>
          <Label Grid.Column="0" Grid.Row="0" Content="Personnummer" IsVisible="{Binding SSNEnabled}" />
          <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding SSN}" IsVisible="{Binding SSNEnabled}" />
        </StackPanel>
        <StackPanel>
          <Label Grid.Column="0" Grid.Row="0" Content="E-post" />
          <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding Email}" />
        </StackPanel>
        <StackPanel>
          <Label Grid.Column="0" Grid.Row="0" Content="Telefon" />
          <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding Phone}" />
        </StackPanel>
      </UniformGrid>
      <UniformGrid Columns="3" ColumnSpacing="20">
        <StackPanel>
          <Label Grid.Column="0" Grid.Row="0" Content="Address" />
          <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding Address.StreetAddress}" />
        </StackPanel>
        <Label /> <!-- spacer -->
        <Label /> <!-- spacer -->
        <StackPanel>
          <Label Grid.Column="0" Grid.Row="0" Content="Postkod" />
          <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding Address.PostalCode}" />
        </StackPanel>
        <StackPanel>
          <Label Grid.Column="0" Grid.Row="0" Content="Ort" />
          <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding Address.Town}" />
        </StackPanel>
        <StackPanel>
          <Label Grid.Column="0" Grid.Row="0" Content="Land" />
          <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding Address.Country}" />
        </StackPanel>
      </UniformGrid>
      
      <StackPanel Orientation="Horizontal" Spacing="40" HorizontalAlignment="Center">
        <Button Classes="nav yes" Command="{Binding SaveCommand}">
            <StackPanel>
                <Label Content="&#xe182;" />
                <Label Content="Spara" />
            </StackPanel>
        </Button>
        <Button Classes="nav no" Command="{Binding CancelCommand}">
            <StackPanel>
                <Label Content="&#xe4f6;" />
                <Label Content="Avbryt" />
            </StackPanel>
        </Button>
      </StackPanel>

    </StackPanel>

</UserControl>
