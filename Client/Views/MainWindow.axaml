<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Client.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Client.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Client">
    
    <Design.DataContext>
        <vm:MainWindowViewModel></vm:MainWindowViewModel>
    </Design.DataContext>


    <StackPanel Background="{DynamicResource ColorBg1}">
        <Border Background="{DynamicResource ColorBg2}" BorderBrush="{DynamicResource ColorText1}" BorderThickness="0 0 0 1">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10" Height="50">
                <Button Classes="nav" Command="{Binding GoToHomeCommand}">
                    <StackPanel>
                        <Label Content="&#xe2c2;" />
                        <Label Content="Startsida" />
                    </StackPanel>
                </Button>
                <Button Classes="nav" Command="{Binding GoToCoursesCommand}">
                    <StackPanel>
                        <Label Content="&#xe5fe;" />
                        <Label Content="Kurser" />
                    </StackPanel>
                </Button>
                <Button Classes="nav" Command="{Binding GoToStudents}">
                    <StackPanel>
                        <Label Content="&#xe62c;" />
                        <Label Content="Elever" />
                    </StackPanel>
                </Button>
                <Button Classes="nav" Command="{Binding GoToTeachers}">
                    <StackPanel>
                        <Label Content="&#xe516;" />
                        <Label Content="Lärare" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <UserControl Content="{Binding CurrentView}" />

    </StackPanel>

</Window>
